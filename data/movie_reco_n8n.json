    {
      "parameters": {
        "jsCode": "// Strict grounding: keep only movies that were actually returned by search_movies in THIS run,\n// and overwrite title/genres with the dataset values.\nconst esc = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\nconst res = $input.first().json;\nconst parsed = res.output || {};\nconst steps = res.intermediateSteps || [];\n\nlet blob = steps.map(s => typeof s.observation === 'string' ? s.observation : JSON.stringify(s.observation ?? '')).join('\\n');\nblob = blob.replace(/\\\\+\"/g, '\"');\n\nconst known = new Map();\nconst re = /movieId: (\\d+) \\| title: (.+?) \\| genres: ([^\"\\n\\\\]*)/g;\nlet m;\nwhile ((m = re.exec(blob)) !== null) {\n  if (!known.has(m[1])) known.set(m[1], { movieId: m[1], title: m[2].trim(), genres: m[3].trim() });\n}\nconst byTitle = new Map([...known.values()].map(r => [r.title.toLowerCase(), r]));\n\nconst seen = new Set();\nconst grounded = [];\nfor (const r of (parsed.recommendations || [])) {\n  const hit = known.get(String(r.movieId)) || byTitle.get(String(r.title || '').toLowerCase());\n  if (!hit || seen.has(hit.movieId)) continue;\n  seen.add(hit.movieId);\n  grounded.push({ ...hit, reason: r.reason || '' });\n}\n\nconst prompt = $('Movie Prompt Form').first().json.prompt;\nconst items = grounded.slice(0, 10).map(r =>\n  '<li><b>' + esc(r.title) + '</b><br/>Genres: ' + esc(r.genres.split(',').map(s => s.trim()).filter(Boolean).join(', ')) +\n  '<br/>' + esc(r.reason) + '</li>').join('');\n\nconst heading = grounded.length === 3 ? 'Top 3 recommended movies' : 'Recommended movies (' + grounded.length + ')';\nlet html = '<h2>' + heading + '</h2><p><i>For: ' + esc(prompt) + '</i></p>';\nif (parsed.answer) html += '<p>' + esc(parsed.answer) + '</p>';\nhtml += grounded.length ? '<ol>' + items + '</ol>' : '<p>No matching movies were found in the uploaded dataset.</p>';\n\nreturn [{ json: { html, recommendations: grounded, retrievedCount: known.size } }];\n"
      },
