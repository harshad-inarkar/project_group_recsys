      "parameters": {
        "jsCode": "// Resume support: drop rows before the chosen start row, keep only the 3 MovieLens columns.\nconst start = Math.max(0, Number($('Upload MovieLens CSVs').first().json.start_row) || 0);\nreturn $input.all()\n  .slice(start)\n  .filter(i => i.json.movieId && i.json.title)\n  .map(i => ({ json: { movieId: String(i.json.movieId), title: i.json.title, genres: i.json.genres || '' } }));\n"
      },
