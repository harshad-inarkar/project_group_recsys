{
  "name": "project_group_recsys_qdrant_final",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "embed-profile",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-embed",
      "name": "Webhook: Embed Profile",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_QDRANT_URL:6333/collections/project-group-index/points/delete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "YOUR_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"filter\": {\n    \"must\": [\n      {\n        \"key\": \"metadata.uid\",\n        \"match\": {\n          \"value\": \"{{ $('Webhook: Embed Profile').item.json.body.uid }}\"\n        }\n      }\n    ]\n  }\n}",
        "options": {}
      },
      "id": "http-delete",
      "name": "Delete Old Vector (HTTP)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        200,
        0
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const text = $('Webhook: Embed Profile').item.json.body.combinedText;\nreturn [{ json: { profile_data: text } }];"
      },
      "id": "format-text",
      "name": "Format Text for Loader",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "mode": "insert",
        "collectionName": "project-group-index",
        "options": {}
      },
      "id": "qdrant-insert",
      "name": "Qdrant Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1,
      "position": [
        650,
        0
      ]
    },
    {
      "parameters": {},
      "id": "gemini-embed-1",
      "name": "Google Gemini Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [
        650,
        200
      ]
    },
    {
      "parameters": {
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "uid",
                "value": "={{ $('Webhook: Embed Profile').item.json.body.uid }}"
              },
              {
                "name": "status",
                "value": "={{ $('Webhook: Embed Profile').item.json.body.status }}"
              }
            ]
          }
        }
      },
      "id": "default-data-loader",
      "name": "Default Data Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1,
      "position": [
        800,
        200
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "get-recommendations",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-reco",
      "name": "Webhook: Get Reco",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        400
      ]
    },
    {
      "parameters": {
        "mode": "retrieve",
        "collectionName": "project-group-index",
        "query": "={{ $json.body.combinedText }}",
        "topK": 8,
        "options": {
          "filter": "={\n  \"must\": [\n    {\n      \"key\": \"metadata.status\",\n      \"match\": {\n        \"value\": \"open\"\n      }\n    }\n  ]\n}"
        }
      },
      "id": "qdrant-retrieve",
      "name": "Qdrant Vector Store Search",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1,
      "position": [
        250,
        400
      ]
    },
    {
      "parameters": {},
      "id": "gemini-embed-2",
      "name": "Google Gemini Embeddings1",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [
        250,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "const requestingUid = $('Webhook: Get Reco').item.json.body.uid;\nconst documents = $input.all();\nconst uids = [];\n\nfor (const doc of documents) {\n  if (doc.json && doc.json.metadata && doc.json.metadata.uid) {\n    const matchUid = doc.json.metadata.uid;\n    if (matchUid !== requestingUid) {\n      uids.push(matchUid);\n    }\n  }\n}\n\nreturn [{ json: { uids: [...new Set(uids)].slice(0, 5) } }];"
      },
      "id": "code-filter",
      "name": "Code: Filter & Extract UIDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        550,
        400
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.uids }}",
        "options": {}
      },
      "id": "webhook-respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        800,
        400
      ]
    }
  ],
