      "parameters": {
        "jsCode": "const requestingUid = $('Webhook: Get Reco').item.json.body.uid;\nconst documents = $input.all();\n\n// LangChain wraps metadata inside the doc payload\nconst uids = documents\n  .map(doc => (doc.json.document?.metadata?.uid ?? doc.json.metadata?.uid))\n  .filter(uid => uid && uid !== requestingUid)\n  .slice(0, 5);\n\nreturn [{ json: { uids } }];"
